# Local development uses SQLite — no database server to install.
# For production (Render), DATABASE_URL is injected automatically from the Postgres instance.
DATABASE_URL=sqlite:///./genai_resource.db

# Chat / query understanding / summaries — get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_FALLBACK_MODEL=openai/gpt-oss-20b:free

# Embeddings for semantic search — get a free key at https://aistudio.google.com/apikey
# (OpenRouter has no embeddings endpoint, so this stays on Gemini.)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_EMBED_MODEL=models/gemini-embedding-001

JWT_SECRET=change-this-dev-secret
FAISS_INDEX_PATH=./embeddings/employee_index.faiss
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
